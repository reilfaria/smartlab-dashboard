# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit .env ke git.

# Kredensial Supabase (pakai SERVICE ROLE key di sini, bukan anon key,
# karena Raspi butuh izin insert/update dan RLS mem-block anon untuk itu)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=isi-service-role-key-disini

# Identitas perangkat (harus sama dengan yang dipakai dashboard)
DEVICE_ID=raspi-apel-01

# Kunci sederhana biar endpoint /outdoor tidak sembarang device bisa kirim data
ESP32_API_KEY=ganti-dengan-kunci-rahasia-bebas

# Port UART sensor ZH03B (pin 8/10 = GPIO14/15 = UART0)
PM_UART_PORT=/dev/serial0
PM_UART_BAUD=9600

# Interval push data live ke Supabase (detik)
LIVE_INTERVAL_SEC=5
# Interval simpan ke log historis (detik) - 600 = 10 menit
LOG_INTERVAL_SEC=600

[Unit]
Description=SmartLab APEL - sensor collector
After=network-online.target
Wants=network-online.target
# jangan pernah berhenti mencoba restart
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartlab/raspberry_pi
EnvironmentFile=/home/pi/smartlab/raspberry_pi/.env
ExecStart=/usr/bin/python3 /home/pi/smartlab/raspberry_pi/main.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
